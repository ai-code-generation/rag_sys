# Basic RAG System Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# NVIDIA NGC Configuration
# =============================================================================
# Required: Your NGC API Key for accessing NVIDIA NIM services
# Get your API key from: https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=your_ngc_api_key_here

# =============================================================================
# Model Directory Configuration
# =============================================================================
# Directory where NIM models will be cached
# This should be an absolute path on your host system
MODEL_DIRECTORY=/path/to/your/model/cache

# =============================================================================
# User Configuration
# =============================================================================
# User ID for running NIM containers (use your current user ID)
# Run 'id -u' to get your user ID
USERID=1000

# =============================================================================
# GPU Configuration
# =============================================================================
# GPU device IDs for different services
# Use 'nvidia-smi' to see available GPUs
VECTORSTORE_GPU_DEVICE_ID=0
EMBEDDING_MS_GPU_ID=0
INFERENCE_GPU_COUNT=1

# =============================================================================
# LLM Model Configuration
# =============================================================================
# Model name for the LLM inference service
APP_LLM_MODELNAME=meta/llama3-8b-instruct

# Server URL for local NIM LLM service (automatically configured)
APP_LLM_SERVERURL=nemollm-inference:8000/v1

# =============================================================================
# Embedding Model Configuration
# =============================================================================
# Model name for the embedding service
APP_EMBEDDINGS_MODELNAME=nvidia/nv-embedqa-e5-v5

# Model engine for embeddings (use nvidia-ai-endpoints for NIM)
APP_EMBEDDINGS_MODELENGINE=nvidia-ai-endpoints

# Server URL for local NIM embedding service (automatically configured)
APP_EMBEDDINGS_SERVERURL=nemollm-embedding:8000/v1

# =============================================================================
# Vector Store Configuration
# =============================================================================
# Collection name for storing embeddings
COLLECTION_NAME=nvidia_api_catalog

# =============================================================================
# Docker Configuration
# =============================================================================
# Directory for Docker volumes (optional, defaults to current directory)
DOCKER_VOLUME_DIRECTORY=.

# Tag for built images
TAG=latest

# Playground mode (default or speech)
PLAYGROUND_MODE=default

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level for the application (DEBUG, INFO, WARN, ERROR, CRITICAL)
LOGLEVEL=INFO

# =============================================================================
# Quick Start Instructions
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update NGC_API_KEY with your actual NGC API key
# 3. Update MODEL_DIRECTORY with your preferred model cache directory
# 4. Update USERID with your user ID (run 'id -u' to get it)
# 5. Adjust GPU device IDs if you have multiple GPUs
# 6. Run: docker compose up -d --build
#
# Services will be available at:
# - RAG Playground UI: http://localhost:8090
# - Chain Server API: http://localhost:8081
# - Milvus Vector DB: http://localhost:19530
# - LLM Inference: http://localhost:8000
# - Embedding Service: http://localhost:9080