# NVIDIA API Configuration
NVIDIA_API_KEY=nvapi-your-key-here

# Model Configuration
APP_LLM_MODELNAME=meta/llama3-8b-instruct
APP_EMBEDDINGS_MODELNAME=nvidia/nv-embedqa-e5-v5

# Model Engine Configuration (nvidia-ai-endpoints for cloud, local-nim for local)
APP_LLM_MODELENGINE=nvidia-ai-endpoints
APP_EMBEDDINGS_MODELENGINE=nvidia-ai-endpoints

# Server URLs (leave empty for cloud endpoints, set for local NIM)
APP_LLM_SERVERURL=
APP_EMBEDDINGS_SERVERURL=

# Vector Database Configuration
COLLECTION_NAME=nvidia_api_catalog

# Retrieval Configuration
APP_RETRIEVER_TOPK=4
APP_RETRIEVER_SCORETHRESHOLD=0.25

# Text Splitting Configuration
APP_TEXTSPLITTER_CHUNKSIZE=506
APP_TEXTSPLITTER_CHUNKOVERLAP=200

# Logging Configuration
LOGLEVEL=INFO

# UI Configuration
PLAYGROUND_MODE=default

# Docker Configuration
TAG=latest

# NIM Services Configuration (for local NIM deployment)
# Set these when using local NIM services instead of cloud endpoints
NGC_API_KEY=
MODEL_DIRECTORY=
USERID=1000

# GPU Configuration for NIM services
INFERENCE_GPU_COUNT=1
EMBEDDING_MS_GPU_ID=0
RANKING_MS_GPU_ID=0
