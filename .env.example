# Example environment configuration for RAG system
# Copy this file to .env and update the values

# =============================================================================
# DEPLOYMENT MODE: Choose between LOCAL NIM or CLOUD API
# =============================================================================

# NVIDIA API Key (for cloud API fallback or additional services)
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# REQUIRED for local NIM deployment: NGC API key (requires GPU)
# Get your NGC API key from: https://ngc.nvidia.com/
NGC_API_KEY=your-ngc-api-key-here

# Local model storage directory for NIM caching
MODEL_DIRECTORY=./models

# OPTIONAL: Container user ID (leave empty for default)
USERID=

# Storage configuration
DOCKER_VOLUME_DIRECTORY=./volumes

# GPU configuration (for local deployment)
INFERENCE_GPU_COUNT=all
LLM_MS_GPU_ID=0
EMBEDDING_MS_GPU_ID=0
RANKING_MS_GPU_ID=0
VECTORSTORE_GPU_DEVICE_ID=0

# Database settings
POSTGRES_PASSWORD=password
POSTGRES_USER=postgres
POSTGRES_DB=api

# Vector store collection
COLLECTION_NAME=nvidia_api_catalog

# Model configuration for local NIM deployment
APP_LLM_MODELNAME=meta/llama3-8b-instruct
APP_LLM_SERVERURL=http://nemollm-inference:8000/v1
APP_EMBEDDINGS_MODELNAME=nvidia/nv-embedqa-e5-v5
APP_EMBEDDINGS_MODELENGINE=nvidia-ai-endpoints
APP_EMBEDDINGS_SERVERURL=http://nemollm-embedding:8000/v1

# For cloud API deployment, use these instead:
# APP_LLM_MODELNAME=meta/llama3-70b-instruct
# APP_LLM_SERVERURL=
# APP_EMBEDDINGS_SERVERURL=

# Vector database configuration
APP_VECTORSTORE_URL=http://milvus:19530
APP_VECTORSTORE_NAME=milvus

# Service endpoints (for local deployment)
CHAIN_SERVER_URL=http://chain-server:8081
RAG_PLAYGROUND_URL=http://localhost:8090

# Logging level
LOGLEVEL=INFO

# UI mode (default or speech)
PLAYGROUND_MODE=default
